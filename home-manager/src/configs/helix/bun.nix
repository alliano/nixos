{ pkgs, ... }:

# Bun 1.4.3, defined here instead of taken from `pkgs.bun`.
#
# No nixpkgs we can reach has this version: the main pin ships 1.2.2,
# nixpkgs-unstable 1.3.13, and even nixpkgs master is at 1.4.2 (October 2026).
# Upstream publishes prebuilt binaries only (no source build), so this is the
# same shape as the nixpkgs derivation: unpack the release zip, patch the
# interpreter and the openssl it dlopen's, generate completions.
#
# Consumed by the language modules under ./langs/{js,ts,vue,svelte}.
pkgs.stdenvNoCC.mkDerivation (finalAttrs: {
  pname = "bun";
  version = "1.4.3";

  # `baseline` is the build nixpkgs itself uses: same binary, compiled without
  # requiring AVX2. Only x86_64-linux is fetched, this machine is the only
  # consumer.
  src = pkgs.fetchurl {
    url = "https://github.com/oven-sh/bun/releases/download/bun-v${finalAttrs.version}/bun-linux-x64-baseline.zip";
    hash = "sha256-H8LtrIQxApCeOhvh2NmALMYHHPB05n6IIx9P/g+LOXs=";
  };

  strictDeps = true;
  nativeBuildInputs = [
    pkgs.unzip
    pkgs.installShellFiles
    pkgs.autoPatchelfHook
  ];
  buildInputs = [ pkgs.openssl ];

  dontConfigure = true;
  dontBuild = true;

  installPhase = ''
    runHook preInstall

    install -Dm 755 ./bun $out/bin/bun
    ln -s $out/bin/bun $out/bin/bunx

    runHook postInstall
  '';

  # Completions are generated by running the binary, so they have to come after
  # autoPatchelf has made it runnable.
  postPhases = [ "postPatchelf" ];
  postPatchelf = ''
    installShellCompletion --cmd bun \
      --bash <(SHELL="bash" $out/bin/bun completions) \
      --zsh <(SHELL="zsh" $out/bin/bun completions) \
      --fish <(SHELL="fish" $out/bin/bun completions)
  '';

  meta = {
    description = "Incredibly fast JavaScript runtime, bundler, transpiler and package manager - all in one";
    homepage = "https://bun.sh";
    changelog = "https://bun.sh/blog/bun-v${finalAttrs.version}";
    sourceProvenance = with pkgs.lib.sourceTypes; [ binaryNativeCode ];
    license = with pkgs.lib.licenses; [
      mit # bun core
      lgpl21Only # javascriptcore and webkit
    ];
    mainProgram = "bun";
    platforms = [ "x86_64-linux" ];
  };
})
